# Copy to .env and adjust for local development.

# Service
FEATURE_STORE_APP_NAME=feature-store-platform
FEATURE_STORE_ENVIRONMENT=development
FEATURE_STORE_LOG_LEVEL=INFO
FEATURE_STORE_HOST=0.0.0.0
FEATURE_STORE_PORT=8000

# Online store (Redis / ElastiCache)
FEATURE_STORE_REDIS_URL=redis://localhost:6379/0
FEATURE_STORE_REDIS_KEY_PREFIX=fs
FEATURE_STORE_ONLINE_TTL_SECONDS=86400

# Offline store (object storage / warehouse)
FEATURE_STORE_OFFLINE_STORE_URI=s3://feature-store/offline
FEATURE_STORE_OFFLINE_STORE_FORMAT=parquet

# Registry
FEATURE_STORE_REGISTRY_PATH=file:///var/lib/feature-store/registry.db
